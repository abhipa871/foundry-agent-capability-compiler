# The server reads process environment. Export these or prefix npm run dev; this file is not auto-loaded.
# Default preview mode performs no model inference.
FOUNDRY_BENCHMARK_LIVE=false
# Pin a model available to your authenticated Codex CLI account.
# Existing experiment scripts continue to default to gpt-5.5.
FOUNDRY_BENCHMARK_MODEL=gpt-6.1-sol

# General task contracts are trusted application code, never model/request JSON.
# FOUNDRY_TASK_MODULE=C:/absolute/path/to/config/tasks.example.ts
# General provider transports read server-side environment credentials:
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# Optional live departure experiment settings:
# FOUNDRY_GEMINI_MODEL=gemini-3.8-flash
# FOUNDRY_DEPARTURE_REPEATS=2
